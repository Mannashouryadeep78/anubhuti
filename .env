# ─────────────────────────────────────────────────────────────────────────────
# ANUBHUTI — Environment Variables
# Copy this to .env and fill in all values before running docker-compose
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=anubhuti
POSTGRES_PASSWORD=change_this_strong_password

# Redis
REDIS_PASSWORD=change_this_redis_secret

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_64_byte_hex_string_here
JWT_REFRESH_SECRET=generate_another_64_byte_hex_string_here

# Supabase (for User Service passcode validation)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_DATABASE_URL="postgresql://postgres.svjnrkzeqgqxcrjrrmcg:5%26ciUJv%2FRyu2b%2FV@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres"

# Razorpay (get from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Notifications
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=ANBHTI

# Monitoring
GRAFANA_PASSWORD=change_this_grafana_password
